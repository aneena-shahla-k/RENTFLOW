# Server Configuration
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/rentflow
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/rentflow_test

# JWT Authentication (Replace with strong random secrets in production)
JWT_ACCESS_SECRET=replace-with-strong-64-char-access-secret
JWT_REFRESH_SECRET=replace-with-strong-64-char-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay (Test Mode - Leave blank to use clearly labelled Development Payment Simulator)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (Optional - Falls back to local /uploads storage in development)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Nodemailer Email (Optional - Logs preview/JSON in development if not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RentFlow <no-reply@rentflow.local>

# Development-only Super Admin Seed (Only used when running seed:superadmin in non-production)
DEV_SUPERADMIN_EMAIL=superadmin@rentflow.local
DEV_SUPERADMIN_PASSWORD=ChangeMeSuperAdmin!2026
